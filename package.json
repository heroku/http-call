{
  "name": "@heroku/http-call",
  "description": "make http requests",
  "version": "5.6.2",
  "author": "Heroku",
  "bugs": "https://github.com/heroku/http-call/issues",
  "dependencies": {
    "chalk": "^4.1.2",
    "content-type": "^1.0.5",

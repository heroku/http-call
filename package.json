    "is-retry-allowed": "^2.2.0",
    "is-stream": "^2.0.1",
    "tunnel-agent": "^0.6.0"
  },
  "devDependencies": {
    "@types/content-type": "^1.1.9",
    "@types/nock": "^10.0.3",
    "@types/node": "22.16.5",
    "@types/sinon": "^17.0.4",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^7.32.0",
    "eslint-config-oclif": "^4.0.0",
    "eslint-config-oclif-typescript": "^3.1.14",
    "nock": "^13.5.6",
    "rimraf": "^6.1.3",
    "sinon": "^20.0.0",
    "strip-ansi": "6.0.1",
    "typescript": "4.9.5",
    "vitest": "^4.1.11"
  },
  "engines": {
    "node": ">=16.0.0"
  },
  "files": [
    "lib"
  ],
  "homepage": "https://github.com/heroku/http-call",
  "keywords": [
    "http",
    "request",
    "rest"
  ],
  "license": "ISC",
  "main": "lib/http.js",
  "repository": "heroku/http-call",
  "scripts": {
    "clean": "rimraf lib",
    "build": "npm run clean && tsc",
